# Projet Supabase (Project Settings > API Keys). Copie ce fichier en .env.local
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Adresse où est hébergée la page sign/index.html
EXPO_PUBLIC_SIGN_URL=https://signer.exemple.fr
# RevenueCat (Project settings > API keys), clés publiques par plateforme
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# Pages légales affichées sur l'écran d'abonnement (exigées par Apple et Google)
EXPO_PUBLIC_TERMS_URL=https://dicta.app/cgu
EXPO_PUBLIC_PRIVACY_URL=https://dicta.app/confidentialite
